# ======================= SERVER (set as Space secrets/variables, NOT committed) =======================
STORE_BACKEND=hub                       # "hub" in production, "local" for development without Hugging Face
HF_TOKEN=hf_xxx                         # write access to ADAPTER_REPO + SUBMISSIONS_REPO
ADAPTER_REPO=your-user/court-asr-adapters
SUBMISSIONS_REPO=your-user/court-asr-submissions
CLIENT_API_KEYS={"court-chennai":"<random-key-1>","court-madurai":"<random-key-2>","court-coimbatore":"<random-key-3>"}
ADMIN_API_KEY=<random-admin-key>
MIN_CLIENTS=3                           # courts that must submit before a round runs
DP_CLIP_NORM=1.0                        # server re-clips every update to this L2 norm
SERVER_NOISE_MULT=0.0                   # leave 0 unless you add privacy accounting (see README)
MAX_WEIGHT_SAMPLES=200
MAX_UPLOAD_MB=200
GITHUB_REPO=your-user/fl-court-asr      # repo containing .github/workflows/promote-adapter.yml
GITHUB_DISPATCH_TOKEN=ghp_xxx           # fine-grained PAT, this repo only, permission "Contents: Read and write" (required by the repository_dispatch API)

# local development only (STORE_BACKEND=local)
LOCAL_STORE_DIR=./local_store

# ======================= CLIENT (each court's machine) =======================
FL_SERVER_URL=https://your-user-court-asr-aggregator.hf.space
FL_CLIENT_ID=court-chennai
FL_API_KEY=<that court's key from CLIENT_API_KEYS>
